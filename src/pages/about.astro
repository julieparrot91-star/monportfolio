---
import Layout from '../layouts/SimplePage.astro';
import CertificationBadge from '../components/CertificationBadge.astro';
import { certifications } from '../data/certifications';
---

<Layout
	title="À propos"
	description="À propos de Julien Parrot">
	<p>Doté d'une forte capacité d'adaptation et d'un sens aigu du service, je suis passionné par les nouvelles technologies et l'infrastructure cloud.
	</p>
	Mon objectif est de mettre à profit mes compétences en administration Azure et en gestion d'infrastructure au sein d'une entreprise dynamique.
	</p>
<p>
<center>
<h1>Formation</h1>
	<div class="education-list">
		<div class="education-item">
			<h3>Master Développement Logiciel et IOT</h3>
			<p class="school">H3 Hitema - Issy-les-Moulineaux</p>
			<p class="year">2021 - 2023</p>
		</div>
		<div class="education-item">
			<h3>SUP3 Développement web</h3>
			<p class="school">École Iris - Paris 17</p>
			<p class="year">2020 - 2021</p>
		</div>
		<div class="education-item">
			<h3>BTS SIO Spécialité SLAM</h3>
			<p class="school">Lycée Parc des Loges - Evry</p>
			<p class="year">2017 - 2019</p>
		</div>
	</div>
	<p>

	<div class="certification-badges">
		{certifications.map((cert) => (
			<CertificationBadge
				name={cert.name}
				issuer={cert.issuer}
				credlyUrl={cert.credlyUrl}
				dateIssued={cert.dateIssued}
				expirationDate={cert.expirationDate}
				inProgress={cert.inProgress}
				badgeImageUrl={cert.badgeImageUrl}
			/>
		))}
	</div>

	<style>
		.certification-badges {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			max-width: 900px;
			margin: 2rem auto;
			gap: 1.5rem;
			justify-items: center;
		}

		@media (min-width: 1024px) {
			.certification-badges {
				grid-template-columns: repeat(3, 1fr);
			}
		}

		@media (min-width: 768px) and (max-width: 1023px) {
			.certification-badges {
				grid-template-columns: repeat(2, 1fr);
			}
		}

		@media (max-width: 767px) {
			.certification-badges {
				grid-template-columns: 1fr;
			}
		}

		.education-list {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			margin: 1rem 0;
		}

		.education-item {
			text-align: left;
			padding: 1rem;
			border-left: 3px solid var(--accent, #00a8ff);
			background: rgba(0, 0, 0, 0.05);
			border-radius: 0 8px 8px 0;
		}

		.education-item h3 {
			margin: 0 0 0.5rem 0;
			font-size: 1.1rem;
		}

		.education-item .school {
			margin: 0;
			color: #666;
		}

		.education-item .year {
			margin: 0.25rem 0 0 0;
			font-size: 0.9rem;
			color: #888;
		}
	</style>

</Layout>
