---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects'))
	.filter((project) => project.data.versionStatus !== 'previous') // Only show current versions
	.sort((a, b) => {
		const dateA = a.data.launchedDate || a.data.startedDate;
		const dateB = b.data.launchedDate || b.data.startedDate;
		return dateB.valueOf() - dateA.valueOf();
	});

// Helper to get clean slug from project id
const getSlug = (id: string) => id.endsWith('/index') ? id.replace(/\/index$/, '') : id;

const categoryLabels = {
	'aws-security': 'Sécurité AWS',
	'aws-infra': 'Infrastructure AWS',
	'homelab': 'Homelab',
	'ai-tools': 'IA & Automatisation',
	'local-dev': 'Développement Local',
	'aws-ai': 'IA/ML AWS',
	'frontend-development': 'Développement Frontend'
};

const statusLabels: Record<string, string> = {
	'launched': 'Lancé',
	'in-development': 'En développement'
};
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={`Projets | ${SITE_TITLE}`} description="Projets Cloud security et DevSecOps" />
		<style>
			main {
				width: min(1200px, 95%);
				margin: 0 auto;
				padding: var(--space-lg) 0;
			}
			.intro {
				margin-bottom: var(--space-lg);
				max-width: 100%;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--space-lg);
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				border: 2px solid var(--border-color);
				border-radius: 12px;
				overflow: hidden;
				background: var(--bg-primary);
				transition: all 0.3s ease;
			}

			/* Light mode card styling - darker background with good contrast */
			:global(:root:not(.dark)) ul li {
				background: #f0f4ef;
				border-color: #d4dbd3;
			}

			:global(:root:not(.dark)) ul li:hover {
				border-color: var(--accent);
			}

			:global(.dark) ul li {
				background: #0d1a0d;
				border-color: #1a2e1a;
			}

			:global(.dark) ul li:hover {
				border-color: var(--accent);
			}
			ul li:hover {
				border-color: rgb(var(--accent));
				transform: translateY(-4px);
				box-shadow: 0 12px 24px rgba(var(--gray), 0.15);
			}
			ul li * {
				text-decoration: none;
			}
			ul li img {
				margin-bottom: 0;
				border-radius: 0;
				width: 100%;
				transition: transform 0.3s ease;
			}
			ul li:hover img {
				transform: scale(1.02);
			}
			ul li a {
				display: block;
			}
			.card-content {
				padding: 1.25rem;
			}
			.title {
				margin: 0 0 0.5rem 0;
				color: rgb(var(--black));
				line-height: 1.2;
				transition: color 0.2s ease;
			}
			.meta {
				margin: 0.5rem 0;
				color: rgb(var(--gray));
				font-size: var(--font-size-sm);
			}
			.category {
				display: inline-block;
				background: rgba(74, 103, 65, 0.65);
				color: white;
				padding: 0.25rem 0.5rem;
				border-radius: 4px;
				font-size: 0.75rem;
				margin-right: 0.5rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}
			.status {
				font-weight: 600;
				text-transform: uppercase;
				font-size: 0.8rem;
			}
			.status.launched {
				color: green;
			}
			.status.in-development {
				color: orange;
			}
			.description {
				margin: 0.75rem 0;
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
				line-height: 1.5;
			}
			.tech-stack {
				margin: 0.75rem 0 0 0;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			.tech-tag {
				display: inline-block;
				background: var(--bg-secondary);
				padding: 0.2rem 0.5rem;
				border-radius: 3px;
				margin-right: 0.25rem;
				margin-bottom: 0.25rem;
			}

			/* Light mode tech tags - slightly darker for contrast on card */
			:global(:root:not(.dark)) .tech-tag {
				background: #e4e9e3;
			}

			ul li:hover .title {
				color: rgb(var(--accent));
			}
			/* Mobile: 320px - 767px */
			@media (max-width: 767px) {
				ul {
					grid-template-columns: 1fr;
					gap: var(--space-md);
				}
			}

			/* Tablet: 768px - 1023px */
			@media (min-width: 768px) and (max-width: 1023px) {
				ul {
					grid-template-columns: repeat(2, 1fr);
					gap: var(--space-md);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="intro">
					<h1>Projets</h1>
					<p>Voici quelques projets sur lesquels j’ai travaillé. certifié Microsoft Azure Administrator (AZ-104), je mets en pratique mes compétences en administration cloud Azure à travers divers projets techniques.</p>
					<p>Vous trouverez également des projets de développement web, d’infrastructure et de dépannage informatique reflète mon parcours professionnel.</p>
				</div>
				{projects.length === 0 ? (
					<p>Pas encore de projets. Revenez bientôt !</p>
				) : (
					<ul>
						{projects.map((project) => (
							<li>
								<a href={`/projects/${getSlug(project.id)}/`}>
									{project.data.heroImage && (
										<Image width={720} height={360} src={project.data.heroImage} alt="" />
									)}
									<div class="card-content">
										<h3 class="title">{project.data.title}</h3>
										<div class="meta">
											<span class="category">{categoryLabels[project.data.category]}</span>
											<span class={`status ${project.data.status}`}>
												{statusLabels[project.data.status] || project.data.status}
											</span>
											{project.data.version && <span> · {project.data.version}</span>}
										</div>
										<p class="description">{project.data.description}</p>
										<div class="tech-stack">
											{project.data.techStack.map((tech) => (
												<span class="tech-tag">{tech}</span>
											))}
										</div>
									</div>
								</a>
							</li>
						))}
					</ul>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
